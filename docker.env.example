# Copy this file to docker.env and fill in required values.
#
# Persistence (root docker compose): named volumes …_app_data and …_mongo_data
#   backend  app_data  → /app/data   (SQLite, sessions, media; keep paths below)
#   mongodb  mongo_data → /data/db
# Multi-env (dev/tst/uat/prod): see docs/docker-multi-env.md#data-volumes-sqlite-sessions-media-mongodb

# Telegram API credentials (required)
API_ID=
API_HASH=

# Auth signing secret (required)
JWT_SECRET=change-me-in-production

# Data and logging
LOG_LEVEL=INFO
TESTING=0

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=telegram_copier

# Local persistent paths inside backend container (must stay under /app/data)
SQLITE_PATH=/app/data/app.db
SESSIONS_DIR=/app/data/sessions
MEDIA_ASSETS_DIR=/app/data/media_assets

# Optional live test bot values
# BOT_TOKEN=
# TELEGRAM_TEST_CHAT_ID=
