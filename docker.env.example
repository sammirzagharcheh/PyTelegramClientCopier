# Copy this file to docker.env and fill in required values.

# Telegram API credentials (required)
API_ID=
API_HASH=

# Auth signing secret (required)
JWT_SECRET=change-me-in-production

# Data and logging
LOG_LEVEL=INFO
TESTING=0

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=telegram_copier

# Local persistent paths inside backend container
SQLITE_PATH=/app/data/app.db
SESSIONS_DIR=/app/data/sessions
MEDIA_ASSETS_DIR=/app/data/media_assets

# Optional live test bot values
# BOT_TOKEN=
# TELEGRAM_TEST_CHAT_ID=
