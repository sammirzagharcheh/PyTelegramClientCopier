# Copy to docker.env.prod (gitignored) and fill secrets.
# Used by: deploy/compose/docker-compose.prod.yml
# Use a strong JWT_SECRET: openssl rand -hex 32
#
# Data: tgc-prod_app_data → /app/data (SQLite app.db, sessions, media);
#       tgc-prod_mongo_data → /data/db. Or BIND_MOUNTS=1 → HOST_DATA_ROOT/prod/{app,mongo}.
# Prefer HOST_DATA_ROOT=/var/lib/telegram-copier on servers for clear host backups.

API_ID=
API_HASH=

JWT_SECRET=change-me-prod-use-openssl-rand-hex-32

LOG_LEVEL=WARNING
TESTING=0

MONGO_URI=mongodb://mongodb:27017
MONGO_DB=telegram_copier_prod

SQLITE_PATH=/app/data/app.db
SESSIONS_DIR=/app/data/sessions
MEDIA_ASSETS_DIR=/app/data/media_assets
