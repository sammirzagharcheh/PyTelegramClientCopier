# Copy to docker.env.tst (gitignored) and fill secrets.
# Used by: deploy/compose/docker-compose.tst.yml
#
# Data: tgc-tst_app_data → /app/data (SQLite app.db, sessions, media);
#       tgc-tst_mongo_data → /data/db. Or BIND_MOUNTS=1 → HOST_DATA_ROOT/tst/{app,mongo}.

API_ID=
API_HASH=

JWT_SECRET=change-me-tst

LOG_LEVEL=INFO
TESTING=0

MONGO_URI=mongodb://mongodb:27017
MONGO_DB=telegram_copier_tst

SQLITE_PATH=/app/data/app.db
SESSIONS_DIR=/app/data/sessions
MEDIA_ASSETS_DIR=/app/data/media_assets
