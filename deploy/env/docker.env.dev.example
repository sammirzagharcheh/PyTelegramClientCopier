# Copy to docker.env.dev (gitignored) and fill secrets.
# Used by: deploy/compose/docker-compose.dev.yml
#
# Data persistence (this env = Compose project tgc-dev):
#   Default named volume tgc-dev_app_data  → /app/data  (SQLite, sessions, media)
#   Default named volume tgc-dev_mongo_data → /data/db (MongoDB)
#   Or BIND_MOUNTS=1 → HOST_DATA_ROOT/dev/app and …/dev/mongo on the host
# Keep SQLITE_*/SESSIONS_*/MEDIA_* under /app/data so the mount covers them.

# Telegram API credentials (required)
API_ID=
API_HASH=

# Auth signing secret (required) — unique per environment
JWT_SECRET=change-me-dev

LOG_LEVEL=DEBUG
TESTING=0

# MongoDB (in-compose service name "mongodb")
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=telegram_copier_dev

# Paths inside the backend container (persisted via app_data / bind mount)
SQLITE_PATH=/app/data/app.db
SESSIONS_DIR=/app/data/sessions
MEDIA_ASSETS_DIR=/app/data/media_assets

# Optional image overrides (also set by deploy-env.sh)
# BACKEND_IMAGE=ghcr.io/sammirzagharcheh/pytelegramclientcopier/backend:latest
# FRONTEND_IMAGE=ghcr.io/sammirzagharcheh/pytelegramclientcopier/frontend:latest
# IMAGE_TAG=latest
