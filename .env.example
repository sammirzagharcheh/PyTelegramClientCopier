# Telegram API (required for Telegram - get from https://my.telegram.org)
API_ID=
API_HASH=

# JWT auth (required in production - use a strong random secret)
JWT_SECRET=change-me-in-production

# Optional: MongoDB for message logs
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=telegram_copier

# Optional: Telegram bot for live tests
# BOT_TOKEN=
# TELEGRAM_TEST_CHAT_ID=

# Database (PostgreSQL cutover default)
DB_BACKEND=postgres
DATABASE_URL=postgresql+asyncpg://8n8user:8N8p%40ssw0rd@localhost:5432/8n8DataBase
